<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rice field ground texture for X450 SITL.
  Source image : Google Maps satellite screenshot, 952 x 768 px
  Registration (2026-11-09), world ENU with origin = home = SE paddy corner
  (10.578681 N, 106.416747 E), from two paddy corners seen in the image:
    SE corner  pixel (925, 660) -> world (0, 0)
    SW corner  pixel (157, 755) -> world (-52.75, -7.56)  (10.578613, 106.416265)
  => scale 0.06886 m/px, image rotated +1.11 deg (CCW), size 65.55 x 52.88 m,
     image centre (476, 384) -> world (-31.28, 18.40).
  Check: the East-bank road in the image lies 0.5..3.6 m outside the straight
  SE-NE bank line (road width + curve). Image top ends ~46 m north of home, so
  the north end of the paddy is not covered (rice_plot covers the survey area).
  Imagery (c) Google
-->
<sdf version="1.9">
  <model name="rice_field">
    <static>true</static>
    <pose>-31.28 18.40 0.01 0 0 0.01937</pose>
    <link name="link">
      <visual name="rice_visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>65.55 52.88</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://rice_field/materials/textures/rice.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
