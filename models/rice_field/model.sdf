<?xml version="1.0" encoding="UTF-8"?>
<!--
  Rice field ground texture for X450 SITL.
  Source image : Google Maps satellite, zoom 21, screen scale 100 %
  Image size   : 952 x 768 px
  Scale        : 156543.03 * cos(10.5788 deg) / 2^21 = 0.07338 m/px
  Plane size   : 952 * 0.07338 = 69.86 m (E-W), 768 * 0.07338 = 56.36 m (N-S)
  Home pin     : pixel (559, 381), image centre (476, 384)
                 -> image centre is 6.09 m west of home => pose x = -6.09
  Home         : 10.578723 N, 106.416590 E
  World frame  : ENU (x = east, y = north)
  Imagery (c) Google
-->
<sdf version="1.9">
  <model name="rice_field">
    <static>true</static>
    <pose>-6.09 0 0.01 0 0 0</pose>
    <link name="link">
      <visual name="rice_visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>69.86 56.36</size>
          </plane>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://rice_field/materials/textures/rice.png</albedo_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>