#!/bin/sh
#
# @name Gazebo x450
#
# @type Quadrotor
#

. ${R}etc/init.d/rc.mc_defaults

PX4_SIMULATOR=${PX4_SIMULATOR:=gz}
PX4_GZ_WORLD=${PX4_GZ_WORLD:=default}
PX4_SIM_MODEL=${PX4_SIM_MODEL:=x450}

param set-default SIM_GZ_EN 1

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

param set-default CA_ROTOR0_PX 0.1591
param set-default CA_ROTOR0_PY 0.1591
param set-default CA_ROTOR0_KM 0.05

param set-default CA_ROTOR1_PX -0.1591
param set-default CA_ROTOR1_PY -0.1591
param set-default CA_ROTOR1_KM 0.05

param set-default CA_ROTOR2_PX 0.1591
param set-default CA_ROTOR2_PY -0.1591
param set-default CA_ROTOR2_KM -0.05

param set-default CA_ROTOR3_PX -0.1591
param set-default CA_ROTOR3_PY 0.1591
param set-default CA_ROTOR3_KM -0.05

param set-default SIM_GZ_EC_FUNC1 101
param set-default SIM_GZ_EC_FUNC2 102
param set-default SIM_GZ_EC_FUNC3 103
param set-default SIM_GZ_EC_FUNC4 104

param set-default SIM_GZ_EC_MIN1 112
param set-default SIM_GZ_EC_MIN2 112
param set-default SIM_GZ_EC_MIN3 112
param set-default SIM_GZ_EC_MIN4 112

param set-default SIM_GZ_EC_MAX1 743
param set-default SIM_GZ_EC_MAX2 743
param set-default SIM_GZ_EC_MAX3 743
param set-default SIM_GZ_EC_MAX4 743

param set-default MPC_THR_HOVER 0.60
param set-default NAV_DLL_ACT 2

# Return (RTL) at the survey altitude instead of PX4's default 30 m / 10 m.
# NOTE real flight: check tree heights along the paddy banks before using 6 m.
param set-default RTL_RETURN_ALT 6
param set-default RTL_DESCEND_ALT 6

# Drag Specific Force:
param set-default EKF2_BCOEF_X 0.0
param set-default EKF2_BCOEF_Y 0.0
param set-default EKF2_MCOEF 0.12
